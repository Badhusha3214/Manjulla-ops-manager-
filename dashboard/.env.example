# Copy to .env.local for local dev (Vite auto-loads it, and it's gitignored).
# When building for production, set the same variables in your hosting
# provider's build environment (Cloudflare Pages, Netlify, Vercel, etc).

VITE_WORKER_URL=https://devmorphix-ops-worker.your-subdomain.workers.dev

# Only needed if you set DASHBOARD_API_KEY on the Worker.
VITE_DASHBOARD_API_KEY=
