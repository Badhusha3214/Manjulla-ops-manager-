# Copy to .env (gitignored, never commit the real file).

# From @BotFather after creating your bot.
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Path to the Google service account's downloaded JSON key file (local dev).
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# Alternative to the above: paste the key file's full JSON contents here
# instead, for hosts with no writable filesystem to put a key file on
# (Railway, Render, etc.). Set one or the other, not both.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

# The ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
SHEET_ID=your-google-sheet-id-here

# From Google AI Studio: https://aistudio.google.com/apikey
# Powers free-text understanding (status updates, task creation, Q&A) —
# see bot/ai.js. Any write it proposes still needs a Yes/No tap to apply.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional override — defaults to gemini-3.7-flash in bot/ai.js if unset.
GEMINI_MODEL=

# Cron expression for the evening check-in DM (server-local time).
# Optional — defaults to "0 18 * * *" (6pm) in bot/index.js if unset.
CHECKIN_CRON=
